# Copy to .env for local development. On Railway, set these as service
# Variables instead (DATABASE_URL is injected automatically once you
# attach a Postgres plugin).

APP_NAME=Rauzr Technologies API
ENV=development
DEBUG=true

# Local default is SQLite (zero setup). Railway/production MUST use the
# Postgres connection string Railway injects once you attach the Postgres
# plugin, e.g.:
# postgresql://postgres:password@host:5432/railway
#
# If you deploy a bare backend container without Postgres, DATABASE_URL must
# point inside the DATA_DIR volume (sqlite:////app/data/veritant.db, note
# the 4 slashes for an absolute path) or every restart wipes all users --
# see README: "Login persistence -- root cause & fix". The app refuses to
# boot with ENV=production on an unmounted SQLite path.
DATABASE_URL=sqlite:///./veritant.db
DATA_DIR=/app/data

# Generate a real secret for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=CHANGE_ME_DEV_ONLY_INSECURE_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Comma-separated list of allowed browser origins.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

RATE_LIMIT_PER_MINUTE=30

SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=no-reply@rauzr.local
