# Used only by vite.config.ts during local `npm run dev` to proxy /api to
# your local backend.
VITE_API_PROXY_TARGET=http://localhost:8000

# Leave unset for local dev (requests use the relative /api path + proxy
# above). Set this as a BUILD-TIME variable on Railway's frontend service
# to your deployed backend's public URL, e.g.:
# VITE_API_BASE_URL=https://rauzr-technologies-backend.example
VITE_API_BASE_URL=
